# Backend is same-origin /api (Vite proxy in dev, Nginx in production).
# No keys needed here. The app talks to the self-hosted Node + SQLite API.

# Web Push VAPID public key (safe to commit). Must match the backend's
# VAPID_PUBLIC_KEY. If unset, the app fetches it from /api/push/vapid-public-key.
# VITE_VAPID_PUBLIC_KEY=
