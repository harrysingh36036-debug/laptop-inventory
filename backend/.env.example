# ===== Google Apps Script storage (alternative to the API) =====
# Simplest option — no service account. Set GAS_WEBAPP_URL to the web-app URL
# of the Apps Script that powers the spreadsheet (enable GAS mode, overrides
# Sheets mode below). GAS_KEY must match CONFIG.key inside the Apps Script.
# GAS_WEBAPP_URL=https://script.google.com/macros/s/xxx/exec
# GAS_KEY=change-me

# ===== Google Sheets API storage (optional) =====
# Set these to make Google Sheets the live database instead of SQLite.
# Leave unset to keep using SQLite.

# 1) Enable Sheets as the driver (or simply set SHEETS_SPREADSHEET_ID below)
STORAGE_DRIVER=sheets

# 2) The spreadsheet id = the part of the Google Sheets URL after /d/
#    e.g. https://docs.google.com/spreadsheets/d/ABC123xyz/edit -> ABC123xyz
SHEETS_SPREADSHEET_ID=

# 3) Service account credentials — EITHER the full JSON as a single line,
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# OR a path to the JSON key file:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# 4) How often (ms) the server re-reads the sheet for external edits
SHEETS_POLL_MS=30000

# ===== Server =====
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-in-production