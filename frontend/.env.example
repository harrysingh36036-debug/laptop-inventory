# Supabase (required)
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# MongoDB read API (optional — only needed after the automation workflow has
# migrated old history to MongoDB. See the automation repo's README).
# VITE_MONGO_READ_API_URL=https://<service>.onrender.com
# VITE_MONGO_READ_API_KEY=<your READ_API_KEY>

# Google Apps Script fallback (optional, legacy)
# VITE_GAS_URL=
# VITE_GAS_KEY=